{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --prefix ai-1115-la",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ai-1115",
      "destination": "/ai1115",
      "permanent": true
    },
    {
      "source": "/AI1115",
      "destination": "/ai1115",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ai1115",
      "destination": "/ai1115/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ai1115\\..+"
        }
      ],
      "destination": "/ai1115/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ai1115/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
